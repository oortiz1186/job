HEADLESS=false
MIN_MATCH=85
BROWSER_PROFILE=.browser-profile
SEARCH_BROWSER_PROFILE=.browser-profile-search
WEB_PORT=3210

# openai | gemini | none
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated: linkedin,indeed,computrabajo,occ
PORTALS=linkedin,indeed,computrabajo,occ
SEARCH_MAX_PER_PORTAL=20

# Rendimiento de búsqueda
# Solo se consulta IA cuando el scoring local alcanza este porcentaje.
SEARCH_PREFILTER_SCORE=60
# Vacantes analizadas en paralelo. Recomendado 3-4.
SEARCH_CONCURRENCY=3
# true reduce pausas de navegador y usa defaults más agresivos.
SEARCH_FAST=false
# Caché de evaluaciones IA en horas (7 días por defecto).
SEARCH_CACHE_TTL_HOURS=168

# CV local opcional para uso por terminal. El portal web permite subirlo.
CV_PATH=data/cv.pdf
