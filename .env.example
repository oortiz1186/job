HEADLESS=false
MIN_MATCH=85
BROWSER_PROFILE=.browser-profile
SEARCH_BROWSER_PROFILE=.browser-profile-search
WEB_PORT=3210

# auto | deepseek | gemini | openai | none
AI_PROVIDER=auto
# Si el proveedor principal falla o se queda sin cuota, prueba el siguiente configurado.
AI_FALLBACK=true
AI_FALLBACK_ORDER=deepseek,gemini,openai

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated: linkedin,indeed,computrabajo,occ
PORTALS=linkedin,indeed,computrabajo,occ
SEARCH_MAX_PER_PORTAL=20

# Rendimiento de búsqueda
SEARCH_PREFILTER_SCORE=60
SEARCH_CONCURRENCY=3
SEARCH_FAST=false
SEARCH_CACHE_TTL_HOURS=168

# CV local opcional para uso por terminal. El portal web permite subirlo.
CV_PATH=data/cv.pdf
