HEADLESS=false
MIN_MATCH=85
BROWSER_PROFILE=.browser-profile

# openai | gemini | none
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated: linkedin,indeed,computrabajo,occ
PORTALS=linkedin,indeed,computrabajo,occ
SEARCH_MAX_PER_PORTAL=20

# CV local del usuario. PDF, DOCX o TXT.
CV_PATH=data/cv.pdf
